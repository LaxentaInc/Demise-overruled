name: Automated Client Release Build

on:
  push:
    tags:
      - 'v*' # Triggers whenever you push a tag like v1.0, v1.1, etc.

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest

    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: 'gradle'

    - name: Grant Execute Permissions for Gradlew
      run: git update-index --chmod=+x gradlew
      shell: bash

    - name: Compile Shadow JAR
      run: ./gradlew shadowJar

    - name: Rename Release Binary
      run: |
        mv build/libs/demise-1.8.9-all.jar build/libs/demise.jar
      shell: bash

    - name: Generate Automated GitHub Release
      uses: softprops/action-gh-release@v2
      with:
        files: |
          build/libs/demise.jar
          json/demise.json
        name: Demise OverRuled Build ${{ github.ref_name }}
        body: |
          Automated performance compilation for version ${{ github.ref_name }}.
          
          ### Installation Shortcut:
          1. Press `Win + R` and type `%appdata%\.minecraft\versions`
          2. Create a folder named `demise`
          3. Drag both `demise.jar` and `demise.json` into that folder.
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
